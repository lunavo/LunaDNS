<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Khớp hai đích của LunaDns.App. Test trong Windows/ chỉ chạy cho net8.0-windows, trong MacOS/ chỉ cho net8.0. -->
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <!-- Directory.Build.props đặt TargetFramework=net8.0; để nguyên thì nó đè TargetFrameworks và chỉ build net8.0. -->
    <TargetFramework></TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Compile Remove="MacOS\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Windows\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LunaDns.App\LunaDns.App.csproj" />
  </ItemGroup>

</Project>
