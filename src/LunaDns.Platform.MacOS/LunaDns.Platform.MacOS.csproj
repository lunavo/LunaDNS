<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Bản macOS publish trimmed: cảnh báo trim (IL2xxx) hiện ngay khi build thường, TreatWarningsAsErrors biến thành lỗi. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LunaDns.Platform.MacOS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LunaDns.Core\LunaDns.Core.csproj" />
  </ItemGroup>

</Project>
