<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hai đích: net8.0-windows = bản Windows (UAC, NRPT, Setup); net8.0 = bản macOS (mọi thay đổi hệ thống đi qua
    dịch vụ nền launchd). File trong Windows/ chỉ build cho net8.0-windows, file trong MacOS/ chỉ cho net8.0.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <!-- Directory.Build.props đặt TargetFramework=net8.0; để nguyên thì nó đè TargetFrameworks và chỉ build net8.0. -->
    <TargetFramework></TargetFramework>
    <AssemblyName>LunaDNS</AssemblyName>
    <RootNamespace>LunaDns.App</RootNamespace>
    <Version>0.10.1</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Giữ chỗ cho tới khi T0 đặt giá trị thật (Directory.Build.props); giá trị có sẵn thì giữ nguyên. -->
    <LunaDnsRepository Condition="'$(LunaDnsRepository)' == ''">lunavo/LunaDNS</LunaDnsRepository>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lunadns.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    <!-- Bản macOS publish trimmed: cảnh báo trim (IL2xxx) hiện ngay khi build thường, TreatWarningsAsErrors biến thành lỗi. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Compile Remove="MacOS\**" />
    <ProjectReference Include="..\LunaDns.Platform.Windows\LunaDns.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Windows\**" />
    <ProjectReference Include="..\LunaDns.Platform.MacOS\LunaDns.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LunaDns.App.Tests" />
    <AssemblyMetadata Include="GitHubRepository" Value="$(LunaDnsRepository)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\*.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Icon template cho thanh menu macOS. LunaDNS.icns không nhúng: build/publish-macos.sh chép vào Contents/Resources. -->
    <AvaloniaResource Include="Assets\*-mac.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LunaDns.Core\LunaDns.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

</Project>
