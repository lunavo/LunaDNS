<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:LunaDns.App"
        xmlns:vm="using:LunaDns.App.ViewModels"
        xmlns:v="using:LunaDns.App.Views"
        x:Class="LunaDns.App.Views.MainWindow"
        x:ClassModifier="internal"
        x:DataType="vm:MainViewModel"
        Title="{x:Static app:Strings.AppTitle}"
        Icon="/Assets/lunadns.ico"
        Background="{DynamicResource Brush.Window}"
        Width="560" Height="720" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="38">
  <Window.Styles>
    <!-- Khu Tên miền lần đầu: viền vàng cùng huy hiệu MỚI (spec KH8 5.1) -->
    <Style Selector="Border.card.intro">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <Style Selector="Border.newbadge">
      <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
    </Style>
    <!-- Dòng nhóm bị giữ lại (bỏ chọn nhóm cuối khi DNS đang bật, mockup 1.3) -->
    <Style Selector="Border.grouprow">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- "Xem" phẳng, "Sửa…" là nút thường (mockup 1.1) -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.grouprow.kept">
      <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
    </Style>
  </Window.Styles>
  <!-- Thanh tiêu đề tự vẽ trên nền tối; nút hệ thống vẫn do Windows vẽ. Không nhận chuột để kéo cửa sổ được. -->
  <Grid RowDefinitions="38,*">
    <!-- macOS: chừa chỗ cho ba nút đèn giao thông bên trái. -->
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="{OnPlatform '12,0', macOS='78,0'}" VerticalAlignment="Center" IsHitTestVisible="False">
      <Image Source="{StaticResource Logo.Mark}" Width="20" Height="20" />
      <TextBlock Classes="secondary" Text="{x:Static app:Strings.AppTitle}" FontSize="12" VerticalAlignment="Center" />
    </StackPanel>
  <ScrollViewer Grid.Row="1">
    <StackPanel Margin="20,8,20,20" Spacing="16">

      <!-- Header + huy hiệu trạng thái tổng (KH6 3.1, 3.2) -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Source="{StaticResource Logo.Mark}" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{x:Static app:Strings.AppTitle}" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Classes="secondary" Text="{x:Static app:Strings.HeaderSubtitle}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="2" Classes="pill" VerticalAlignment="Top" Margin="12,4,0,0"
                Classes.good="{Binding Overall.Tone, Converter={x:Static v:ToneConverters.IsGood}}"
                Classes.busy="{Binding Overall.Tone, Converter={x:Static v:ToneConverters.IsBusy}}"
                Classes.error="{Binding Overall.Tone, Converter={x:Static v:ToneConverters.IsError}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="tone" Width="12" Height="12"
                      Classes.good="{Binding Overall.Tone, Converter={x:Static v:ToneConverters.IsGood}}"
                      Classes.busy="{Binding Overall.Tone, Converter={x:Static v:ToneConverters.IsBusy}}"
                      Classes.error="{Binding Overall.Tone, Converter={x:Static v:ToneConverters.IsError}}" />
            <TextBlock Classes="tone" FontWeight="SemiBold" Text="{Binding Overall.Text}"
                       Classes.good="{Binding Overall.Tone, Converter={x:Static v:ToneConverters.IsGood}}"
                       Classes.busy="{Binding Overall.Tone, Converter={x:Static v:ToneConverters.IsBusy}}"
                       Classes.error="{Binding Overall.Tone, Converter={x:Static v:ToneConverters.IsError}}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- macOS: dịch vụ nền chưa cài / không trả lời / bản cũ / tài khoản khác đang dùng (không có nút, B4) -->
      <Border Classes="banner warning" IsVisible="{Binding ShowServiceSetup}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding ServiceSetupText}" TextWrapping="Wrap" />
          <Button Classes="accent" Command="{Binding InstallServiceCommand}" HorizontalAlignment="Left"
                  IsVisible="{Binding ShowInstallServiceButton}">
            <TextBlock Text="{Binding InstallServiceText}" />
          </Button>
        </StackPanel>
      </Border>

      <!-- U1 (spec 2026-11-22): tính năng lần trước để bật mà đang tắt, kèm nút Bật lại -->
      <Border Classes="banner warning" IsVisible="{Binding ShowResumeNotice}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding ResumeNoticeText}" TextWrapping="Wrap" />
            <Button Classes="accent" Command="{Binding ResumeCommand}" HorizontalAlignment="Left">
              <TextBlock Text="{x:Static app:Strings.ResumeButton}" />
            </Button>
          </StackPanel>
          <Button Grid.Column="1" Margin="8,0,0,0" Padding="4" VerticalAlignment="Top" Background="Transparent"
                  Command="{Binding DismissResumeCommand}"
                  ToolTip.Tip="{x:Static app:Strings.DismissMessage}"
                  AutomationProperties.Name="{x:Static app:Strings.DismissMessage}">
            <PathIcon Data="{DynamicResource Icon.Close}" Width="12" Height="12" />
          </Button>
        </Grid>
      </Border>

      <!-- Thanh thông báo theo mức, ngay dưới header (U7) -->
      <Border Classes="banner" IsVisible="{Binding HasMessage}"
              Classes.good="{Binding MessageTone, Converter={x:Static v:ToneConverters.IsGood}}"
              Classes.warning="{Binding MessageTone, Converter={x:Static v:ToneConverters.IsWarning}}"
              Classes.error="{Binding MessageTone, Converter={x:Static v:ToneConverters.IsError}}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Classes="tone" VerticalAlignment="Top" Margin="0,2,8,0"
                    Classes.info="{Binding MessageTone, Converter={x:Static v:ToneConverters.IsInfo}}"
                    Classes.good="{Binding MessageTone, Converter={x:Static v:ToneConverters.IsGood}}"
                    Classes.warning="{Binding MessageTone, Converter={x:Static v:ToneConverters.IsWarning}}"
                    Classes.error="{Binding MessageTone, Converter={x:Static v:ToneConverters.IsError}}" />
          <StackPanel Grid.Column="1" Spacing="6">
            <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            <Button Content="{x:Static app:Strings.RevealReport}" Command="{Binding RevealReportCommand}"
                    IsVisible="{Binding CanRevealReport}" HorizontalAlignment="Left" />
          </StackPanel>
          <Button Grid.Column="2" Margin="8,0,0,0" Padding="4" VerticalAlignment="Top" Background="Transparent"
                  Command="{Binding DismissMessageCommand}"
                  ToolTip.Tip="{x:Static app:Strings.DismissMessage}"
                  AutomationProperties.Name="{x:Static app:Strings.DismissMessage}">
            <PathIcon Data="{DynamicResource Icon.Close}" Width="12" Height="12" />
          </Button>
        </Grid>
      </Border>

      <!-- Có bản mới: tự kiểm khi mở app hoặc nút Kiểm tra cập nhật (spec 2026-11-15) -->
      <Border Classes="banner" IsVisible="{Binding UpdateBanner.IsVisible}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <PathIcon Classes="tone info" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Grid.Column="1" Text="{Binding UpdateBanner.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="accent" Margin="8,0,0,0" VerticalAlignment="Center"
                  Command="{Binding UpdateBanner.OpenCommand}">
            <TextBlock Text="{x:Static app:Strings.UpdateDownloadButton}" />
          </Button>
          <Button Grid.Column="3" Margin="8,0,0,0" Padding="4" VerticalAlignment="Center" Background="Transparent"
                  Command="{Binding UpdateBanner.DismissCommand}"
                  ToolTip.Tip="{x:Static app:Strings.UpdateDismissTooltip}"
                  AutomationProperties.Name="{x:Static app:Strings.UpdateDismissTooltip}">
            <PathIcon Data="{DynamicResource Icon.Close}" Width="12" Height="12" />
          </Button>
        </Grid>
      </Border>

      <!-- Bốn khu theo việc người dùng muốn làm (spec D5): Kiểm tra → Trạng thái → Cập nhật → Gỡ & dọn -->

      <!-- Khu Kiểm tra: kết quả theo nhóm, Áp dụng đề xuất, Tìm cấu hình (spec 4.8, KH6 3.2, D3), Chẩn đoán, Nâng cao -->
      <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,-8">
        <TextBlock Classes="zone" Margin="2,0,0,0" Text="{x:Static app:Strings.ZoneCheck}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding ProbeStatus}" TextWrapping="Wrap"
                   TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <ItemsControl ItemsSource="{Binding ProbeLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProbeLineViewModel">
                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2" AutomationProperties.Name="{Binding AutomationName}">
                  <PathIcon Classes="tone" VerticalAlignment="Top" Margin="0,2,8,0"
                            Classes.good="{Binding Tone, Converter={x:Static v:ToneConverters.IsGood}}"
                            Classes.warning="{Binding Tone, Converter={x:Static v:ToneConverters.IsWarning}}"
                            Classes.error="{Binding Tone, Converter={x:Static v:ToneConverters.IsError}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Group}" FontWeight="SemiBold" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="2" Classes="tone" Text="{Binding Detail}" TextWrapping="Wrap"
                             Classes.good="{Binding Tone, Converter={x:Static v:ToneConverters.IsGood}}"
                             Classes.warning="{Binding Tone, Converter={x:Static v:ToneConverters.IsWarning}}"
                             Classes.error="{Binding Tone, Converter={x:Static v:ToneConverters.IsError}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="secondary" FontSize="12" Text="{x:Static app:Strings.ProbeCustomHint}" TextWrapping="Wrap"
                     IsVisible="{Binding ShowProbeCustomHint}" />
          <TextBlock Classes="secondary" Text="{Binding ProbeHint}" TextWrapping="Wrap" IsVisible="{Binding HasProbeHint}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Command="{Binding CheckCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="button" Data="{DynamicResource Icon.Check}" />
                <TextBlock Text="{x:Static app:Strings.CheckButton}" />
              </StackPanel>
            </Button>
            <Button Content="{x:Static app:Strings.ApplyRecommendedButton}" Command="{Binding ApplyRecommendedCommand}"
                    IsVisible="{Binding CanApplyRecommended}" />
            <Button Content="{x:Static app:Strings.TuneButton}" Command="{Binding TuneCommand}"
                    IsVisible="{Binding !IsTuning}" />
            <Button Content="{x:Static app:Strings.TuneStop}" Command="{Binding StopTuneCommand}"
                    IsVisible="{Binding IsTuning}" />
          </StackPanel>
          <TextBlock Classes="secondary" Text="{Binding TuneStatus}" TextWrapping="Wrap" IsVisible="{Binding HasTuneStatus}" />
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="-8,0,0,0">
            <Button Background="Transparent" Command="{Binding DiagnosticsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="button" Data="{DynamicResource Icon.Diagnostics}" />
                <TextBlock Text="{x:Static app:Strings.DiagnosticsButton}" />
              </StackPanel>
            </Button>
            <Button Background="Transparent" Command="{Binding OpenLogFolderCommand}" Content="{x:Static app:Strings.OpenLogFolderButton}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Expander HorizontalAlignment="Stretch" IsVisible="{Binding HasAdvancedSettings}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="button" Data="{DynamicResource Icon.Advanced}" />
            <TextBlock Text="{x:Static app:Strings.AdvancedHeader}" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Static app:Strings.SplitModeLabel}" />
          <ComboBox SelectedIndex="{Binding SplitModeIndex}" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="{x:Static app:Strings.SplitModeFirstByte}" />
            <ComboBoxItem Content="{x:Static app:Strings.SplitModeMidSni}" />
          </ComboBox>
          <CheckBox IsChecked="{Binding SplitRecords}" Content="{x:Static app:Strings.SplitRecordsLabel}" />
          <TextBlock Classes="secondary" Text="{x:Static app:Strings.SplitRecordsHint}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Static app:Strings.SplitDelayLabel}" />
          <NumericUpDown Value="{Binding SplitDelayMs}" Minimum="0" Maximum="20" Increment="1" FormatString="0" />
          <TextBlock Text="{x:Static app:Strings.DohLabel}" />
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding DohItems}" SelectedIndex="{Binding DohIndex}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding MeasureDohCommand}" Content="{Binding DohMeasureLabel}" />
          </Grid>
          <StackPanel Spacing="6" IsVisible="{Binding IsCustomDoh}">
            <TextBlock Text="{x:Static app:Strings.DohCustomUrlLabel}" />
            <TextBox Text="{Binding CustomDohUrl}" Watermark="https://dns.example.net/dns-query" />
            <TextBlock Text="{x:Static app:Strings.DohCustomAddressesLabel}" />
            <TextBox Text="{Binding CustomDohAddresses}" />
            <Button Command="{Binding SaveCustomDohCommand}" Content="{x:Static app:Strings.DohCustomSave}" />
            <TextBlock Classes="secondary" Text="{Binding CustomDohStatus}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Classes="secondary" Text="{x:Static app:Strings.AdvancedHint}" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>

      <!-- Khu Trạng thái: hai công tắc và các nhóm tên miền -->
      <TextBlock Classes="zone" Text="{x:Static app:Strings.ZoneStatus}" />

      <!-- Hai công tắc: huy hiệu icon, dải màu trái, dòng trạng thái, dòng lỗi riêng (U6) -->
      <ItemsControl ItemsSource="{Binding Features}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FeatureViewModel">
            <Border Classes="card" Classes.on="{Binding IsOn}" Margin="0,0,0,8" Padding="0">
              <Grid ColumnDefinitions="4,*">
                <Border Classes="strip"
                        Classes.good="{Binding Tone, Converter={x:Static v:ToneConverters.IsGood}}"
                        Classes.busy="{Binding Tone, Converter={x:Static v:ToneConverters.IsBusy}}"
                        Classes.error="{Binding Tone, Converter={x:Static v:ToneConverters.IsError}}" />
                <Grid Grid.Column="1" Margin="12,16,16,16" ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="badge" VerticalAlignment="Top" Margin="0,0,12,0">
                    <PathIcon Classes="feature" Classes.dns="{Binding IsDns}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Classes="secondary" Text="{Binding Description}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="tone" Width="12" Height="12" VerticalAlignment="Center"
                                Classes.good="{Binding Tone, Converter={x:Static v:ToneConverters.IsGood}}"
                                Classes.busy="{Binding Tone, Converter={x:Static v:ToneConverters.IsBusy}}"
                                Classes.error="{Binding Tone, Converter={x:Static v:ToneConverters.IsError}}" />
                      <TextBlock Classes="tone" Text="{Binding StatusText}"
                                 Classes.good="{Binding Tone, Converter={x:Static v:ToneConverters.IsGood}}"
                                 Classes.busy="{Binding Tone, Converter={x:Static v:ToneConverters.IsBusy}}"
                                 Classes.error="{Binding Tone, Converter={x:Static v:ToneConverters.IsError}}" />
                    </StackPanel>
                    <TextBlock Classes="tone error" Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" MinWidth="0" MinHeight="2" Height="2" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" Margin="12,0,-12,0" OnContent="" OffContent=""
                                IsChecked="{Binding IsOn, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding Title}" />
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- F1: Tự bật lại (ẩn khi dịch vụ nền là bản cũ hoặc không trả lời) -->
      <StackPanel Spacing="2" Margin="2,0,0,8" IsVisible="{Binding ShowAutoResume}">
        <CheckBox MinWidth="0" Content="{x:Static app:Strings.AutoResumeSwitch}"
                  IsChecked="{Binding AutoResume, Mode=OneWay}" Command="{Binding ToggleAutoResumeCommand}" />
        <TextBlock Classes="secondary" FontSize="12" Text="{x:Static app:Strings.AutoResumeHint}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Tên miền (spec KH8 5.1): hiện trên cả Windows và macOS. Bật/tắt một nhóm là áp ngay, không cần Lưu. -->
      <Border Classes="card" Classes.intro="{Binding ShowDomainsIntro}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <TextBlock Classes="section" Text="{x:Static app:Strings.DomainsSectionTitle}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="newbadge" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding ShowDomainsIntro}">
              <TextBlock Text="{x:Static app:Strings.DomainsNewBadge}" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Window}" />
            </Border>
            <TextBlock Grid.Column="2" Classes="secondary" FontSize="12" Text="{Binding RoutedCountText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
          <ItemsControl ItemsSource="{Binding DomainGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DomainGroupViewModel">
                <Border Classes="grouprow" Classes.kept="{Binding IsKeptBack}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- OneWay + Command như ToggleSwitch: ô đã tự lật lúc bấm, áp lỗi thì Refresh đẩy lại giá trị thật -->
                    <CheckBox VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0"
                              IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleCommand}"
                              AutomationProperties.Name="{Binding Title}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Classes="secondary" Text="{Binding CountText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                      <PathIcon Classes="tone" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding HasStatusIcon}"
                                Classes.good="{Binding StatusTone, Converter={x:Static v:ToneConverters.IsGood}}"
                                Classes.warning="{Binding StatusTone, Converter={x:Static v:ToneConverters.IsWarning}}"
                                Classes.error="{Binding StatusTone, Converter={x:Static v:ToneConverters.IsError}}" />
                      <TextBlock Classes="tone" FontSize="12" Text="{Binding StatusText}" VerticalAlignment="Center"
                                 Classes.good="{Binding StatusTone, Converter={x:Static v:ToneConverters.IsGood}}"
                                 Classes.warning="{Binding StatusTone, Converter={x:Static v:ToneConverters.IsWarning}}"
                                 Classes.error="{Binding StatusTone, Converter={x:Static v:ToneConverters.IsError}}" />
                    </StackPanel>
                    <Button Grid.Column="3" Padding="10,4" FontSize="12" VerticalAlignment="Center"
                            Classes.flat="{Binding !IsCustom}"
                            Content="{Binding OpenText}" Command="{Binding OpenCommand}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="secondary" FontSize="12" Text="{x:Static app:Strings.DomainsFootnote}" TextWrapping="Wrap"
                     Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- Khu Cập nhật: bản app và danh sách tên miền lớp 2 (D4) -->
      <TextBlock Classes="zone" Text="{x:Static app:Strings.ZoneUpdate}" />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding CheckUpdateCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="button" Data="{DynamicResource Icon.Check}" />
                <TextBlock Text="{x:Static app:Strings.CheckUpdateButton}" />
              </StackPanel>
            </Button>
          </Grid>
          <!-- Dòng "Tự cập nhật danh sách" (spec D4): ẩn khi dịch vụ nền là bản cũ -->
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding DomainList.IsVisible}">
            <CheckBox VerticalAlignment="Center" MinWidth="0" Content="{x:Static app:Strings.DomainListSwitch}"
                      IsChecked="{Binding DomainList.IsEnabled, Mode=OneWay}" Command="{Binding DomainList.ToggleCommand}" />
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Classes="tone" FontSize="12" Text="{Binding DomainList.StatusText}" TextWrapping="Wrap"
                         Classes.error="{Binding DomainList.StatusTone, Converter={x:Static v:ToneConverters.IsError}}" />
              <TextBlock Classes="secondary" FontSize="12" Text="{Binding DomainList.ResultText}"
                         IsVisible="{Binding DomainList.ResultText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <Button Grid.Column="2" Padding="10,4" FontSize="12" VerticalAlignment="Center" Classes="flat"
                    Content="{x:Static app:Strings.DomainListCheckNow}" Command="{Binding DomainList.CheckNowCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Khu Gỡ & dọn: Tắt hết mờ khi không có gì bật (U8); không có nút Gỡ thì hiện cách gỡ theo guide -->
      <TextBlock Classes="zone" Text="{x:Static app:Strings.ZoneCleanup}" />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <WrapPanel>
            <Button Command="{Binding DisableAllCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="button" Data="{DynamicResource Icon.Restore}" />
                <TextBlock Text="{x:Static app:Strings.DisableAllButton}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding UninstallAppCommand}" IsVisible="{Binding CanUninstall}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="button" Data="{DynamicResource Icon.Close}" />
                <TextBlock Text="{x:Static app:Strings.UninstallButton}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <TextBlock Classes="secondary" FontSize="12" Text="{x:Static app:Strings.UninstallHint}" TextWrapping="Wrap"
                     IsVisible="{Binding !CanUninstall}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
  </Grid>
</Window>
