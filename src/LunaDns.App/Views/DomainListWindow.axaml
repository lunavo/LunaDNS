<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:LunaDns.App"
        x:Class="LunaDns.App.Views.DomainListWindow"
        x:ClassModifier="internal"
        x:CompileBindings="False"
        Background="{DynamicResource Brush.Window}"
        Width="440" Height="560" MinWidth="360" MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- Nhóm dựng sẵn chỉ xem (spec KH8 5.1, mockup 3.1). -->
  <Grid Margin="20,16,20,18" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Spacing="2">
      <TextBlock x:Name="Header" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Classes="secondary" FontSize="12" Text="{x:Static app:Strings.GroupListSubtitle}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Classes="card" Padding="0" Margin="0,12,0,0">
      <ListBox x:Name="Domains" Background="Transparent"
               FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12.5" />
    </Border>
    <Border Grid.Row="2" Classes="banner" Margin="0,12,0,0">
      <TextBlock FontSize="12" Text="{x:Static app:Strings.GroupListNote}" TextWrapping="Wrap" />
    </Border>
    <Button Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
            Content="{x:Static app:Strings.CloseButton}" Click="OnClose" />
  </Grid>
</Window>
